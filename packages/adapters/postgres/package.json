{
  "name": "@roleforge/adapter-postgres",
  "version": "0.1.0",
  "description": "PostgreSQL storage adapter for RoleForge",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@roleforge/core": "0.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "@types/pg": "^8.23.1",
    "vitest": "^3.2.4"
  }
}
